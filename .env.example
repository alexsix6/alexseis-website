# =============================================================
# alexseis-website Environment Variables
# Copy this file to .env.local and fill in your real values
# NEVER commit .env.local to version control
# =============================================================

# --- OpenAI ---
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# --- Google Cloud / BigQuery ---
# Project ID from Google Cloud Console
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id

# Base64-encoded service account JSON key (for Vercel deployment)
# Generate: cat your-key.json | base64
GOOGLE_APPLICATION_CREDENTIALS_BASE64=BASE64_ENCODED_JSON_HERE

# --- Google Analytics 4 (GA4) ---
# Get your Measurement ID from https://analytics.google.com → Admin → Data Streams
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Supabase (Legacy - only if using chat-backup.js) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
